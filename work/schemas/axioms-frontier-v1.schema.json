{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axioms-frontier/v1",
  "title": "Ordered active repository work view",
  "type": "object",
  "required": ["schema", "repository", "objective", "mode", "product", "maintenance", "parallel"],
  "properties": {
    "schema": {"const": "axioms-frontier/v1"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "objective": {"type": "string", "minLength": 1},
    "mode": {"enum": ["product", "maintenance"]},
    "lifecycle": {"enum": ["active", "retired"], "default": "active"},
    "product": {"$ref": "#/$defs/queue"},
    "maintenance": {"$ref": "#/$defs/queue"},
    "parallel": {"$ref": "#/$defs/queue"}
  },
  "$defs": {
    "queue": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#)?[A-Za-z0-9][A-Za-z0-9._-]*$"}}
  },
  "additionalProperties": true
}
